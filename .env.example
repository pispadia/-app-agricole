# Requis en production : génère une valeur longue et aléatoire.
SECRET_KEY=remplace-moi-par-une-cle-secrete-longue-et-aleatoire
FLASK_ENV=production
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote:5432/base
# Envoi d'e-mails (mot de passe oublié) via Brevo : clé API et adresse d'expédition validée
# BREVO_API_KEY=xkeysib-...
# EMAIL_EXPEDITEUR=ton-adresse@exemple.com
# Modèle économique (montants en FCFA)
# ADMIN_EMAILS=ton-email@exemple.com            # comptes ayant accès à /admin (séparés par des virgules)
# NUMERO_PAIEMENT=77 123 45 67                   # numéro Wave / Orange Money affiché pour payer
# TAUX_COMMISSION=0.05                           # 5 % des ventes livrées
# PRIX_PREMIUM_MENSUEL=3000                      # abonnement Premium de 30 jours
# Paiement en ligne Wave (compte Wave Business, clé API avec l'autorisation « Checkout API »)
# WAVE_API_KEY=wave_sn_prod_...
# Alertes SMS via l'API SMS Orange (developer.orange.com)
# ORANGE_SMS_CLIENT_ID=...
# ORANGE_SMS_CLIENT_SECRET=...
# ORANGE_SMS_EXPEDITEUR=221771234567             # numéro du compte SMS Orange
